[Unit]
Description=CSC Zanzibar Next.js web
After=network.target zanweb-api.service

[Service]
Type=simple
User=zanweb
WorkingDirectory=/opt/zanweb
EnvironmentFile=/opt/zanweb/.env
ExecStart=/usr/bin/node /opt/zanweb/apps/web/.next/standalone/server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
