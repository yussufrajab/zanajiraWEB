packages/shared/src/*.js.map

# misc
*.log
.DS_Store
coverage/
playwright-report/
test-results/

# WSL/Windows NTFS alternate data stream artifacts
*:Zone.Identifier

# runtime (manage.sh pidfiles, logs, minio data)
.run/