# deps
node_modules/
.pnpm-store/

# build
dist/
build/
.next/
out/
*.tsbuildinfo

# env
.env
.env.local
.env.*.local

# prisma generated (committed selectively)
packages/prisma/generated/
packages/prisma/src/*.js
